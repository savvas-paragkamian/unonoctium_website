@Article{Arapitsas2026,
  author       = {Arapitsas, Nikolaos P. and Christakis, Christos A. and Paragkamian*, Savvas and Soultatos, Stefanos and Reden, Franziska and Psarologaki, Chrysianna and Avramakis, Emmanouil and Stamatakis, Alexandros and Markakis, Emmanouil A. and Sarris, Panagiotis F.},
  journal      = {bioRxiv},
  title        = {Unravelling the genomic and functional arsenal of Bacilli endophytes from plants with different lifestyles},
  year         = {2026},
  abstract     = {Endophytic microbiomes of crop wild relatives (CWRs) adapted to extreme environments, such as halophytes, are promising sources of plant-beneficial bacteria and secondary metabolites for sustainable food production. Here, we analyzed 25 Bacilli isolates obtained from CWRs, halophytes, and other plant species in Crete, Greece. Using a hybrid Illumina{\textendash}PacBio sequencing approach, we generated high-quality genomes and performed comparative genomics, phylogenetic, and pangenome analyses, complemented by in vitro assays. We identified 312 biosynthetic gene clusters (BGCs), nearly 60\% of which showed no similarity to known clusters, revealing extensive unexplored biosynthetic potential. These unique BGCs may constitute an adaptive feature enabling endophytic Bacilli to colonize and interact with host plants. The isolates spanned diverse genera (Bacillus, Paenibacillus, Peribacillus, Neobacillus, Cytobacillus, Rossellomorea), including three novel species. Phenotypic assays of our isolates demonstrated high salinity tolerance (up to 17.5\% w/v NaCl) and strong antagonism against major bacterial and fungal phytopathogens. Genome mining further revealed a broad array of putatively plant-beneficial traits related to growth promotion, stress adaptation, host interaction and inhibition of pathogens. Together, these findings show that Bacilli endophytes from wild and halophytic plants possess exceptional phylogenetic novelty, functional diversity, and biosynthetic capacity, providing new genomic and ecological insights into Bacilli associated with plants inhabiting extreme environments.Competing Interest StatementThe authors have declared no competing interest.},
  doi          = {10.64898/2026.02.06.704400},
  elocation-id = {2026.02.06.704400},
  eprint       = {https://www.biorxiv.org/content/early/2026/02/06/2026.02.06.704400.full.pdf},
  publisher    = {Cold Spring Harbor Laboratory},
  url          = {https://www.biorxiv.org/content/early/2026/02/06/2026.02.06.704400},
}

@Article{Nicolosi2026,
  author  = {Nicolosi, Giuseppe and Bellvert, Adri{\`a} and Amorim, Isabel R. and Bal{\'a}zs, Gergely and Bir{\'o}, Anna and Borges, Paulo A. V. and Brad, Traian and Cancellario, Tommaso and Cardoso, Pedro and Cresi, Lorenzo and Crespo, Lu{\'i}s Carlos and {\v{C}}uku{\v{s}}i{\'c}, An{\dj}ela and {\v{C}}upi{\'c}, Iva and Deli{\'c}, Teo and Front, Sophie and Garc{\'i}a-Villar{\'i}n, Adri{\'a}n and Geci, Donard and Hesselberg, Thomas and Kocot-Zalewska, Joanna and Kozel, Peter and Lips, Josiane and Mac{\'i}as-Hern{\'a}ndez, Nuria and Novak, Tone and Orom{\'i}, Pedro and Pantini, Paolo and Paragamian, Kaloust and Paragkamian, Savvas and Pati{\~n}o-Sauma, Diego and Pischiutta, Nikola and Pu{\v{s}}nar, {\v{Z}}ak and Rezac, Milan and Ribera, Carles and Rodrigues, Afonso and Ro{\v{z}}man, Tin and Sivec, Ignac and {\v{S}}tangelj, Mojmir and Toli{\'c}, Karla and Zagmajster, Maja and Pavlek, Martina and Mammola, Stefano},
